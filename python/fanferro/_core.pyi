type AttributeInput = AttributeValue | str | bytes | bytearray | memoryview | int | float | bool | Any
type HeaderValue = str | int | bool

class FanferroError(Exception):
    retryable: bool
    category: str

class ConfigurationError(FanferroError): ...
class ValidationError(FanferroError): ...

class MessageTooLargeError(ValidationError):
    size: int
    limit: int

class AwsError(FanferroError):
    service: str
    operation: str
    kind: str
    code: str | None
    aws_message: str | None
    request_id: str | None
    status: int | None

class ResourceNotFoundError(AwsError): ...
class AccessDeniedError(AwsError): ...
class ThrottledError(AwsError): ...
class TransportError(FanferroError): ...
class PayloadError(FanferroError): ...
class PayloadIntegrityError(PayloadError): ...
class EnvelopeError(FanferroError): ...
class LeaseError(FanferroError): ...
class ShutdownError(FanferroError): ...

